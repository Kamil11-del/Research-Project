{
  "naming": "GTEA",
  "root_data_dir": "./datasets",
  "dataset_name": "gtea",
  "sample_rate": 1,
  "temporal_aug": true,
  "pos": "none",
  "n_mask": 10,
  "patch_size": 10,
  "encoder_params": {
    "use_instance_norm": false,
    "num_layers": 5,
    "num_f_maps": 64,
    "input_dim": 2048,
    "kernel_size": 5,
    "normal_dropout_rate": 0.5,
    "channel_dropout_rate": 0.5,
    "temporal_dropout_rate": 0.5,
    "feature_layer_indices": [
      2,
      3,
      4
    ],
    "d_state": 16,
    "d_conv": 4,
    "expand": 2,
    "bidirectional": true,
    "fusion_type": "gate"
  },
  "decoder_params": {
    "num_layers": 6,
    "num_f_maps": 24,
    "time_emb_dim": 512,
    "kernel_size": 7,
    "dropout_rate": 0.1,
    "d_state": 16,
    "d_conv": 4,
    "expand": 2,
    "bidirectional": true,
    "fusion_type": "gate"
  },
  "diffusion_params": {
    "timesteps": 1000,
    "sampling_timesteps": 25,
    "ddim_sampling_eta": 1.0,
    "snr_scale": 0.5,
    "cond_types": [
      "full",
      "zero",
      "boundary03-",
      "segment=1",
      "segment=1",
      "ant"
    ],
    "detach_decoder": false
  },
  "loss_weights": {
    "encoder_ce_loss": 0.5,
    "encoder_mse_loss": 0.1,
    "encoder_boundary_loss": 0.0,
    "decoder_ce_loss": 0.5,
    "decoder_mse_loss": 0.1,
    "decoder_boundary_loss": 0.1
  },
  "batch_size": 4,
  "learning_rate": 0.0005,
  "weight_decay": 1e-06,
  "num_epochs": 10001,
  "log_freq": 20,
  "class_weighting": true,
  "set_sampling_seed": true,
  "boundary_smooth": 1,
  "soft_label": 1.3,
  "log_train_results": false,
  "postprocess": {
    "type": "purge",
    "value": 3
  }
}